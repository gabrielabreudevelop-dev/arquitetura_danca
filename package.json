{
  "name": "arquitetura-danca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "tipos": "tsc --noEmit",
    "teste": "vitest run --project unidade",
    "teste:integracao": "vitest run --project integracao",
    "build:scripts": "esbuild scripts/migrar.ts scripts/criar-membro-equipe.ts scripts/verificar-restauracao.ts --bundle --platform=node --format=esm --target=node26 --outdir=dist --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "tsx scripts/migrar.ts",
    "backup:verificar": "tsx scripts/verificar-restauracao.ts",
    "equipe:criar": "tsx --env-file-if-exists=.env.local scripts/criar-membro-equipe.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.27",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "better-auth": "1.7.27",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=26"
  }
}

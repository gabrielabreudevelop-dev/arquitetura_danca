# Copie para .env.local e preencha. Nunca versione valores reais.
DATABASE_URL=
# Mínimo de 32 caracteres (ex.: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Opcional. IPs/CIDRs, separados por vírgula, de proxies extras (CDN etc.) que
# acrescentam ao X-Forwarded-For. Deixe vazio com o Traefik do Coolify sozinho,
# que já entrega um único IP de cliente.
PROXIES_CONFIAVEIS=
# Superusuário do Postgres usado pelos testes de integração para criar e
# remover bancos temporários (ex.: postgres://dev:dev@localhost:5432/postgres)
DATABASE_URL_TESTE_ADMIN=
